diff --git a/src/bnetd/friends.cpp b/src/bnetd/friends.cpp
index 50670be..c0e1af1 100644
--- a/src/bnetd/friends.cpp
+++ b/src/bnetd/friends.cpp
@@ -22,6 +22,12 @@
 #include "compat/strcasecmp.h"
 #include "common/list.h"
 #include "common/eventlog.h"
+#include "common/bn_type.h"
+#include "connection.h"
+#include "channel.h"
+#include "game.h"
+#include "common/packet.h"
+#include "common/anongame_protocol.h" 
 
 #include "common/setup_after.h"
 
@@ -375,6 +381,77 @@ namespace pvpgn
 			return nullptr;
 		}
 
-	}
+		
+		extern int friends_notify_status_change(t_connection * user_c)
+		{
+			if (!user_c) return -1;
+			t_account * user_acc = conn_get_account(user_c);
+			if (!user_acc) return -1;
+
+			t_elem * ccurr;
+			LIST_TRAVERSE(connlist(), ccurr)
+			{
+				t_connection * c = (t_connection *)elem_get_data(ccurr);
+				if (!c || c == user_c || conn_get_class(c) != conn_class_bnet)
+					continue;
+				t_account * acc = conn_get_account(c);
+				if (!acc) continue;
+				t_list * flist = account_get_friends(acc);
+				if (!flist) continue;
+
+				t_elem * fcurr;
+				unsigned char i = 0;
+				LIST_TRAVERSE(flist, fcurr)
+				{
+					t_friend * fr = (t_friend *)elem_get_data(fcurr);
+					if (fr && fr->friendacc == user_acc)
+					{
+						t_packet * rpacket = packet_create(packet_class_bnet);
+						if (!rpacket) break;
+						packet_set_size(rpacket, sizeof(t_server_friendinforeply));
+						packet_set_type(rpacket, SERVER_FRIENDINFOREPLY);
+						bn_byte_set(&rpacket->u.server_friendinforeply.friendnum, i);
+
+						unsigned char type = 0;
+						if (friend_get_mutual(fr))
+							type |= FRIEND_TYPE_MUTUAL;
+						if (conn_get_dndstr(user_c))
+							type |= FRIEND_TYPE_DND;
+						if (conn_get_awaystr(user_c))
+							type |= FRIEND_TYPE_AWAY;
+						bn_byte_set(&rpacket->u.server_friendinforeply.type, type);
+
+						t_game * game;
+						t_channel * channel;
+						if ((game = conn_get_game(user_c)))
+						{
+							if (game_get_flag(game) != game_flag_private)
+								bn_byte_set(&rpacket->u.server_friendinforeply.status, FRIENDSTATUS_PUBLIC_GAME);
+							else
+								bn_byte_set(&rpacket->u.server_friendinforeply.status, FRIENDSTATUS_PRIVATE_GAME);
+							packet_append_string(rpacket, game_get_name(game));
+						}
+						else if ((channel = conn_get_channel(user_c)))
+						{
+							bn_byte_set(&rpacket->u.server_friendinforeply.status, FRIENDSTATUS_CHAT);
+							packet_append_string(rpacket, channel_get_name(channel));
+						}
+						else
+						{
+							bn_byte_set(&rpacket->u.server_friendinforeply.status, FRIENDSTATUS_ONLINE);
+							packet_append_string(rpacket, "");
+						}
+
+						bn_int_set(&rpacket->u.server_friendinforeply.clienttag, conn_get_clienttag(user_c));
+						conn_push_outqueue(c, rpacket);
+						packet_del_ref(rpacket);
+						break;
+					}
+					i++;
+				}
+			}
+			return 0;
+		}
+}
 
 }
